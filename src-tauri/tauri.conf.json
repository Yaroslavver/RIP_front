{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "electrolyte-app",
  "version": "0.1.0",
  "identifier": "ru.mgtu.electrolyte",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Концентрации растворов",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self' http: https: data: blob:; img-src 'self' http: https: data: blob:; media-src 'self' http: https: data: blob:; connect-src 'self' http: https:; script-src 'self'; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
